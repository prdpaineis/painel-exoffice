# Modelo. Copie para .env, preencha, e NÃO versione o resultado.
#
#   cp .env.example .env
#
# Em CI, use os secrets do repositório em vez de arquivo — o ambiente tem
# precedência sobre o .env.
#
# ODOO_URL   endereço do servidor, com https://
# ODOO_DB    nome do banco (no Odoo costuma ser igual ao host, mas confira)
# ODOO_LOGIN de preferência um usuário de integração só-leitura, não a conta
#            de uma pessoa: o MMP filtra por empresa, e os números do painel
#            mudam se o login mudar.

ODOO_URL=""
ODOO_DB=""
ODOO_LOGIN=""
ODOO_PASSWORD=""
